# Relay Dashboard — env reference. Copy to .env.local and fill in.
# .env.local is gitignored; .env.example is the public template.

# -----------------------------------------------------------------------------
# Supabase — required
# -----------------------------------------------------------------------------

# Public-side (browser): anon / publishable key. RLS-gated reads.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-side only (route handlers in /api/*): service-role key. Bypasses
# RLS so cross-project semantic + keyword search works across every project,
# regardless of the project's anon read policy. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Anthropic — required for /api/synthesize
# -----------------------------------------------------------------------------

# Server-side only. Used by /api/synthesize to produce the LLM paragraph
# summary on the top search hits. NEVER prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Demo mode — optional, public deploy only
# -----------------------------------------------------------------------------

# When set to "true", the SEMANTIC search and SYNTHESIZE features are gated
# behind a "Show demo" affordance backed by pre-recorded real output. Keeps
# random visitors and bots from driving up Anthropic / embedding costs on
# the public dashboard. KEYWORD search stays fully live.
#
# Leave unset (or set to "false") for local development and private
# deployments where you want the live features.
#
# NEXT_PUBLIC_ prefix is required so the value reaches the browser bundle.
NEXT_PUBLIC_DEMO_MODE=false
